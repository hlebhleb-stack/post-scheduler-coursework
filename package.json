{
  "name": "post-scheduler-coursework",
  "version": "1.0.0",
  "description": "Курсовой проект: планирование публикаций в Telegram и YouTube",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/app.js",
    "worker": "node server/worker.js",
    "migrate": "node server/migrate.js",
    "test:api": "node test/run-postman.mjs",
    "test": "node --test test/*.test.js",
    "seed": "node server/scripts/seed.js",
    "format": "prettier --write client server test .vscode *.json *.js *.yml",
    "format:check": "prettier --check client server test .vscode *.json *.js *.yml"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "react-use-measure": "^2.1.7",
    "sanitize-html": "^2.18.2",
    "sequelize": "^6.37.8",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "prettier": "^3.10.1",
    "vite": "^8.4.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
