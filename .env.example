# Для Compose пароль должен совпадать в двух строках. Используй URL-безопасный пароль.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://scheduler:replace-me@db:5432/scheduler
# Сгенерировать независимо: openssl rand -hex 32
JWT_SECRET=
# Сгенерировать один раз и сохранить: openssl rand -base64 32
CHANNEL_KEY=
PORT=3000

# OAuth-клиент Google типа Web application. Секрет хранится только на сервере.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://post-scheduler-coursework.onrender.com/api/youtube/callback
