{
  "info": {
    "name": "Курсовая — API планировщика публикаций",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Запускайте целиком по порядку. Создаёт уникальные тестовые аккаунты, удаляет свои тестовые посты, каналы и файлы медиатеки. Все посты сохраняются черновиками. Для каналов нужен отдельный тестовый бот или локальный тестовый процесс. Аккаунты остаются, так как API удаления аккаунта отсутствует."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Проверка доступности",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('База доступна', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now() + '-' + Math.random().toString(36).slice(2,8);",
              "pm.collectionVariables.set('email', 'postman-' + suffix + '@example.com');",
              "pm.collectionVariables.set('other_email', 'postman-other-' + suffix + '@example.com');",
              "pm.collectionVariables.set('password', 'Postman-test-' + suffix);",
              "['token','other_token','library_id','channel_id','post_id','media_post_id','attachment_id'].forEach(key => pm.collectionVariables.unset(key));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
